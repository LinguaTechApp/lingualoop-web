---
import StoreBadges from './StoreBadges.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n';

const t = useTranslations(getLocaleFromUrl(Astro.url));
const hero = t('hero');
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="hero__content container">
    <div class="hero__text">
      <h1 class="hero__title">
        {hero.titleLead} <span class="hero__title-accent">{hero.titleAccent}</span>
      </h1>

      <p class="hero__subtitle">{hero.subtitle}</p>

      <div class="hero__ctas">
        <StoreBadges variant="hero" />
      </div>

      <ul class="hero__trust" role="list">
        {hero.trust.map((item) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__glow" aria-hidden="true"></div>

      <figure class="hero__portrait">
        <img
          src="/assets/optimized/emma-studio-360.webp"
          srcset="/assets/optimized/emma-studio-360.webp 360w, /assets/optimized/emma-studio-720.webp 720w"
          sizes="(min-width: 1024px) 380px, (min-width: 769px) 320px, 250px"
          width="360"
          height="480"
          alt={hero.imageAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <span class="hero__live" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </span>
      </figure>

      <div class="hero__chat">
        <p class="bubble bubble--tutor" lang="en">{hero.tutorBubble}</p>

        <div class="hero__answer">
          <p class="bubble bubble--learner" lang="en">
            {hero.learnerBefore} <del>{hero.learnerWrong}</del> <ins>{hero.learnerRight}</ins> {hero.learnerAfter}
          </p>
          <p class="hero__note">
            <span class="hero__note-icon" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            {hero.correctionNote}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: calc(var(--nav-height) + var(--space-2xl)) 0 var(--space-3xl);
  }

  @media (min-width: 769px) {
    .hero {
      padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-4xl);
    }
  }

  /* Cheap static glow (gradients, no blur filters) */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 55% at 12% 8%, rgba(29, 73, 244, 0.22), transparent 70%),
      radial-gradient(45% 50% at 88% 70%, rgba(123, 47, 224, 0.18), transparent 70%),
      radial-gradient(40% 40% at 60% 20%, rgba(92, 125, 255, 0.10), transparent 70%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 769px) {
    .hero__content {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-3xl);
    }
  }

  /* ---------- Text ---------- */
  .hero__text {
    text-align: center;
  }

  @media (min-width: 769px) {
    .hero__text {
      text-align: left;
    }
  }

  .hero__title {
    font-size: clamp(2.6rem, 6.4vw, 4.75rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-lg);
    text-wrap: balance;
  }

  .hero__title-accent {
    background: linear-gradient(120deg, var(--color-blue-light) 10%, #A855F7 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero__subtitle {
    font-size: var(--font-size-md);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 34em;
    margin: 0 auto var(--space-xl);
    text-wrap: pretty;
  }

  @media (min-width: 769px) {
    .hero__subtitle {
      font-size: 1.2rem;
      margin-left: 0;
    }
  }

  .hero__trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm) var(--space-lg);
    margin-top: var(--space-lg);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  @media (min-width: 769px) {
    .hero__trust {
      justify-content: flex-start;
    }
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero__trust svg {
    color: #34D399;
    flex-shrink: 0;
  }

  /* ---------- Visual: portrait + chat ---------- */
  .hero__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 420px;
    width: 100%;
    margin: 0 auto;
  }

  .hero__glow {
    position: absolute;
    inset: 4% 0 20%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(29, 73, 244, 0.45), transparent);
    z-index: 0;
  }

  .hero__portrait {
    position: relative;
    z-index: 1;
    width: 250px;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: #8d8f92;
    box-shadow:
      0 40px 80px -24px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 769px) {
    .hero__portrait { width: 320px; border-radius: 32px; }
  }

  @media (min-width: 1024px) {
    .hero__portrait { width: 380px; }
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Small "speaking" waveform chip on the portrait (decorative) */
  .hero__live {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 30px;
    padding: 0 11px;
    border-radius: var(--radius-full);
    background: rgba(9, 13, 24, 0.62);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .hero__live span {
    display: block;
    width: 3px;
    border-radius: 2px;
    background: #67E8F9;
    animation: wave 1.1s ease-in-out infinite;
  }

  .hero__live span:nth-child(1) { height: 8px; animation-delay: -0.2s; }
  .hero__live span:nth-child(2) { height: 14px; animation-delay: -0.5s; }
  .hero__live span:nth-child(3) { height: 18px; animation-delay: -0.1s; }
  .hero__live span:nth-child(4) { height: 12px; animation-delay: -0.7s; }
  .hero__live span:nth-child(5) { height: 7px; animation-delay: -0.35s; }

  @keyframes wave {
    0%, 100% { transform: scaleY(0.55); }
    50% { transform: scaleY(1); }
  }

  /* Chat: stacked under the portrait on mobile, overlapping it from tablet up */
  .hero__chat {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
    margin-top: -64px;
  }

  .bubble {
    font-size: 1rem;
    line-height: 1.45;
    padding: 12px 16px;
    border-radius: 20px;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.7);
    text-align: left;
  }

  .bubble--tutor {
    align-self: flex-start;
    max-width: 80%;
    color: #fff;
    background: #2E3A94;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom-left-radius: 6px;
    animation: bubbleIn 0.5s ease-out 0.25s both;
  }

  .hero__answer {
    align-self: flex-end;
    max-width: 88%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-sm);
    animation: bubbleIn 0.5s ease-out 0.7s both;
  }

  .bubble--learner {
    color: var(--color-text-primary);
    background: #151B2E;
    border: 1px solid rgba(255, 182, 39, 0.55);
    border-bottom-right-radius: 6px;
  }

  .bubble--learner del {
    color: #F87171;
    text-decoration-thickness: 2px;
    text-decoration-color: rgba(248, 113, 113, 0.9);
  }

  .bubble--learner ins {
    text-decoration: none;
    font-weight: 700;
    color: #34D399;
  }

  .hero__note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 8px;
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: #D1FAE5;
    background: rgba(6, 78, 59, 0.85);
    border: 1px solid rgba(52, 211, 153, 0.35);
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.6);
  }

  .hero__note-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #10B981;
    color: #04241A;
    flex-shrink: 0;
  }

  @media (min-width: 769px) {
    .hero__visual {
      max-width: none;
      padding-bottom: var(--space-2xl);
    }

    .hero__chat {
      position: absolute;
      inset: auto 0 0 0;
      margin-top: 0;
      width: auto;
    }

    .bubble--tutor {
      max-width: 62%;
      margin-left: -4%;
      margin-bottom: var(--space-sm);
    }

    .hero__answer {
      max-width: 74%;
      margin-right: -4%;
    }

    .bubble {
      font-size: 1.0625rem;
      padding: 14px 18px;
    }
  }

  @keyframes bubbleIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble--tutor,
    .hero__answer,
    .hero__live span {
      animation: none;
    }
  }
</style>
