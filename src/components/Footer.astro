---
import { getLocaleFromUrl, localizedPath, useTranslations } from '../i18n';
import { SOCIAL_LINKS } from '../social';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const nav = t('nav');
const footer = t('footer');
const homeHref = localizedPath(locale, '/');
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href={homeHref} class="footer__brand-link" aria-label="Fluo home">
          <img
            class="footer__logo"
            src="/assets/logo.png"
            srcset="/assets/logo.png 1x, /assets/logo-2x.png 2x"
            width="32"
            height="32"
            alt=""
            aria-hidden="true"
          />
          <span class="footer__name">Fluo</span>
        </a>
        <p class="footer__tagline">{footer.tagline}</p>
        <ul class="footer__social" aria-label={footer.followUs}>
          {SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.url}
                class="footer__social-link"
                target="_blank"
                rel="noopener"
                aria-label={social.name}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={social.icon} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <nav class="footer__links" aria-label={nav.navLabel}>
        <div class="footer__links-group">
          <h3 class="footer__links-title">{footer.productTitle}</h3>
          <a href="#features">{nav.features}</a>
          <a href="#how-it-works">{nav.howItWorks}</a>
          <a href="#why-fluo">{nav.whyFluo}</a>
          <a href="#download">{nav.download}</a>
        </div>
        <div class="footer__links-group">
          <h3 class="footer__links-title">{footer.companyTitle}</h3>
          <a href="/support/">{footer.support}</a>
          <a href="/privacy-policy/">{footer.privacy}</a>
          <a href="/terms-of-use/">{footer.terms}</a>
        </div>
      </nav>
    </div>
    <div class="footer__bottom">
      <p>{footer.rights}</p>
      <p class="footer__bottom-meta">{footer.craft}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-4xl);
    padding: var(--space-3xl) 0 var(--space-xl);
    background: linear-gradient(180deg, transparent 0%, rgba(14, 19, 34, 0.6) 100%);
    border-top: 1px solid var(--color-border);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 769px) {
    .footer__top {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-3xl);
      align-items: start;
    }
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 360px;
  }

  .footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .footer__logo {
    width: 32px;
    height: 32px;
    display: block;
  }

  .footer__name {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .footer__social {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .footer__social-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }

  .footer__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .footer__links-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__links-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  .footer__links a {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-base);
  }

  .footer__links a:hover {
    color: var(--color-text-primary);
  }

  .footer__bottom {
    padding-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: center;
    text-align: center;
  }

  @media (min-width: 769px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer__bottom p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer__bottom-meta {
    color: var(--color-text-muted);
    opacity: 0.7;
  }
</style>
