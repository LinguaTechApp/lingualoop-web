---
// Neutral phone frame (no OS chrome), so the same screens fit Android and iOS.
// The parent sets --phone-w; radius and bezel scale with it. The screen keeps
// the capture's aspect ratio (`ratio`).
interface Props {
  src: string;
  alt: string;
  /** Screen aspect ratio as "w / h", e.g. "540 / 1102". */
  ratio: string;
  /** Intrinsic pixel size of the image (avoids layout shift). */
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
}
const { src, alt, ratio, width, height, loading = 'lazy' } = Astro.props;
---

<div class="phone" style={`--phone-ratio: ${ratio}`}>
  <div class="phone__screen">
    <img
      src={src}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : undefined}
    />
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: var(--phone-w, 260px);
    border-radius: calc(var(--phone-w, 260px) * 0.14);
    padding: calc(var(--phone-w, 260px) * 0.028);
    background: linear-gradient(145deg, #2a2f3d, #12151e);
    box-shadow:
      0 30px 60px -15px rgba(0, 0, 0, 0.8),
      0 0 0 1.5px rgba(255, 255, 255, 0.08),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.03);
  }

  .phone__screen {
    aspect-ratio: var(--phone-ratio);
    background: #000;
    border-radius: calc(var(--phone-w, 260px) * 0.112);
    overflow: hidden;
    position: relative;
  }

  .phone__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
</style>
