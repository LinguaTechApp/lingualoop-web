---
import SectionLabel from './SectionLabel.astro';
import PhoneFrame from './PhoneFrame.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n';

// Draft screens: Android 1.5.7 captures (540×1199, no system bars). Step 3
// (per-answer feedback) has no approved capture yet → «captura pendiente».
const shots: (string | null)[] = [
  '/assets/optimized/r43-escena.jpg',
  '/assets/optimized/r43-responder.jpg',
  null
];

const t = useTranslations(getLocaleFromUrl(Astro.url));
const c = t('conversation');
const steps = c.steps.map((step, i) => ({ ...step, src: shots[i], number: i + 1 }));
---

<section id="how-it-works" class="conv">
  <div class="container">
    <header class="section-head">
      <SectionLabel text={c.label} />
      <h2 class="section-title">{c.title}</h2>
      <p class="section-sub">{c.subtitle}</p>
    </header>

    <ol class="conv__steps" role="list">
      {steps.map((step) => (
        <li class="conv__step reveal">
          <div class="conv__visual">
            <PhoneFrame
              ratio="540 / 1199"
              src={step.src ?? undefined}
              alt={step.alt}
              width={540}
              height={1199}
            >
              <div class="conv__pending">captura pendiente</div>
            </PhoneFrame>
          </div>
          <div class="conv__body">
            <span class="conv__num" aria-hidden="true">{step.number}</span>
            <h3 class="conv__lead">{step.lead}</h3>
            <p class="conv__text">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <p class="conv__close reveal">
      <span class="conv__close-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
      </span>
      <span>{c.closingNote}</span>
    </p>
  </div>
</section>

<style>
  .conv {
    padding: var(--space-4xl) 0;
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: var(--nav-height);
  }

  .conv__steps {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 900px) {
    .conv__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }

  .conv__step {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .conv__visual {
    --phone-w: 210px;
    position: relative;
    display: flex;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg) 0;
    background:
      radial-gradient(70% 60% at 50% 35%, rgba(29, 73, 244, 0.28), transparent 75%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-xl);
  }

  @media (min-width: 1100px) {
    .conv__visual { --phone-w: 232px; }
  }

  .conv__pending {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #3A3D45;
    color: #C9CBD1;
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .conv__body {
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
  }

  .conv__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-blue);
    color: #fff;
    font-size: var(--font-size-sm);
    font-weight: 800;
    margin-bottom: var(--space-md);
    box-shadow: 0 0 0 4px rgba(29, 73, 244, 0.18);
  }

  .conv__lead {
    font-size: var(--font-size-lg);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-sm);
  }

  .conv__text {
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .conv__close {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: 640px;
    margin: var(--space-2xl) auto 0;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(255, 182, 39, 0.10), rgba(255, 182, 39, 0.03));
    border: 1px solid rgba(255, 182, 39, 0.25);
    color: var(--color-text-primary);
    font-weight: 500;
    line-height: 1.5;
  }

  .conv__close-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 182, 39, 0.16);
    color: #FFB627;
  }
</style>
