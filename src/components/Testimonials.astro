---
import SectionLabel from './SectionLabel.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n';

// Avatar initial + gradient are structural; order matches `testimonials.items`
// in the dictionaries. Quote and country come from the active locale.
const avatars = [
  { initial: 'V', gradient: 'linear-gradient(135deg, #EC4899, #8B5CF6)' },
  { initial: 'C', gradient: 'linear-gradient(135deg, #3B82F6, #06B6D4)' },
  { initial: 'A', gradient: 'linear-gradient(135deg, #F59E0B, #EF4444)' },
];

const t = useTranslations(getLocaleFromUrl(Astro.url));
const tm = t('testimonials');
const testimonials = tm.items.map((item, i) => ({ ...item, ...avatars[i] }));
---

<section class="testimonials reveal" id="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="testimonials__header">
      <SectionLabel text={tm.label} />
      <h2 class="testimonials__title" id="testimonials-title">
        {tm.titleLine1}<br />
        <span class="testimonials__title-emphasis">{tm.titleAccent}</span>
      </h2>

      <div class="testimonials__rating" aria-label={tm.ratingAria}>
        <div class="testimonials__rating-stars" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
        </div>
        <div class="testimonials__rating-meta">
          <span class="testimonials__rating-score">{tm.ratingScore}</span>
          <span class="testimonials__rating-detail">{tm.ratingDetail}</span>
        </div>
      </div>
    </div>

    <div class="testimonials__grid">
      {testimonials.map((item) => (
        <article class="testimonials__card">
          <div class="testimonials__stars" role="img" aria-label={tm.cardStarsAria}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"/></svg>
          </div>
          <blockquote class="testimonials__quote">{item.quote}</blockquote>
          <footer class="testimonials__author">
            <div class="testimonials__avatar" style={`background: ${item.gradient}`} aria-hidden="true">{item.initial}</div>
            <div class="testimonials__person">
              <div class="testimonials__name">{item.name}</div>
              <div class="testimonials__meta">{item.country} · {item.level}</div>
            </div>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding: var(--space-4xl) 0;
    position: relative;
    background: linear-gradient(180deg, transparent 0%, var(--color-bg-secondary) 40%, transparent 100%);
  }

  .testimonials__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-3xl);
  }

  .testimonials__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: var(--space-md) 0 var(--space-lg);
  }

  .testimonials__title-emphasis {
    font-weight: 800;
    color: inherit;
  }

  .testimonials__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 7px 14px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .testimonials__rating-stars {
    display: inline-flex;
    gap: 2px;
    color: rgba(255, 182, 39, 0.75);
  }

  .testimonials__rating-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .testimonials__rating-score {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .testimonials__rating-detail {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .testimonials__rating {
      flex-direction: column;
      gap: var(--space-sm);
      border-radius: var(--radius-lg);
    }
    .testimonials__rating-detail {
      font-size: 0.8rem;
    }
  }

  /* Grid */
  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 769px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }

  /* Card */
  .testimonials__card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition: transform var(--transition-base), border-color var(--transition-base), background var(--transition-base);
  }

  .testimonials__card:hover {
    transform: translateY(-4px);
    border-color: var(--color-blue-border);
    background: var(--color-bg-card-hover);
  }

  .testimonials__stars {
    display: inline-flex;
    gap: 2px;
    color: #FFB627;
  }

  .testimonials__quote {
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-text-primary);
    margin: 0;
    flex: 1;
  }

  .testimonials__author {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .testimonials__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .testimonials__person {
    display: flex;
    flex-direction: column;
  }

  .testimonials__name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .testimonials__meta {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }
</style>
