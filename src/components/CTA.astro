---
import StoreBadges from './StoreBadges.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n';

const t = useTranslations(getLocaleFromUrl(Astro.url));
const cta = t('cta');
const hero = t('hero');
---

<section id="download" class="cta">
  <div class="container">
    <div class="cta__card reveal">
      <img
        class="cta__avatar"
        src="/assets/optimized/emma-studio-360.webp"
        width="88"
        height="88"
        alt={hero.imageAlt}
        loading="lazy"
        decoding="async"
      />
      <h2 class="cta__title">{cta.title}</h2>
      <p class="cta__subtitle">{cta.subtitle}</p>
      <StoreBadges />
    </div>
  </div>
</section>

<style>
  .cta {
    padding: var(--space-3xl) 0 var(--space-2xl);
    scroll-margin-top: var(--nav-height);
  }

  .cta__card {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: var(--space-3xl) var(--space-lg);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(92, 125, 255, 0.28);
    background:
      radial-gradient(70% 90% at 50% 0%, rgba(29, 73, 244, 0.45), transparent 70%),
      radial-gradient(50% 70% at 90% 100%, rgba(123, 47, 224, 0.30), transparent 70%),
      var(--color-bg-card);
    box-shadow: 0 40px 80px -40px rgba(29, 73, 244, 0.45);
  }

  @media (min-width: 769px) {
    .cta__card { padding: var(--space-4xl) var(--space-2xl); }
  }

  .cta__avatar {
    width: 88px;
    height: 88px;
    margin: 0 auto var(--space-lg);
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    border: 3px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 6px rgba(29, 73, 244, 0.35), 0 16px 32px -8px rgba(0, 0, 0, 0.6);
  }

  .cta__title {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-md);
    text-wrap: balance;
  }

  .cta__subtitle {
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 32em;
    margin: 0 auto var(--space-xl);
    font-size: var(--font-size-md);
    text-wrap: pretty;
  }
</style>
