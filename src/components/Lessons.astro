---
import Showcase from './Showcase.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n';

const t = useTranslations(getLocaleFromUrl(Astro.url));
const l = t('lessons');
---

<Showcase
  id="lessons"
  label={l.label}
  title={l.title}
  text={l.text}
  shots={['/assets/optimized/r43-leccion.jpg', '/assets/optimized/r43-leccion-completa.jpg']}
  alts={l.alts}
>
  <ul class="tags" role="list">
    {l.tags.map((tag) => (
      <li class="tag">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
        {tag}
      </li>
    ))}
  </ul>
</Showcase>

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  @media (min-width: 900px) {
    .tags { justify-content: flex-start; }
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px 8px 11px;
    border-radius: var(--radius-full);
    background: var(--color-blue-subtle);
    border: 1px solid var(--color-blue-border);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-weight: 500;
    line-height: 1.2;
  }

  .tag svg {
    color: var(--color-blue-light);
    flex-shrink: 0;
  }
</style>
