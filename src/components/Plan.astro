---
import Showcase from './Showcase.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n';

const t = useTranslations(getLocaleFromUrl(Astro.url));
const p = t('plan');
---

<Showcase
  id="plan"
  label={p.label}
  title={p.title}
  text={p.text}
  shots={['/assets/optimized/r43-plan.jpg', '/assets/optimized/r43-inicio.jpg']}
  alts={p.alts}
  reverse
  tint="violet"
>
  <p class="plus">
    <span class="plus__icons" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </span>
    <span><strong>{p.plusLead}</strong> {p.plusText}</span>
  </p>
</Showcase>

<style>
  .plus {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    background: rgba(123, 47, 224, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.25);
    color: var(--color-text-primary);
    line-height: 1.5;
    text-align: left;
    max-width: 30em;
  }

  .plus strong {
    font-weight: 700;
  }

  .plus__icons {
    display: inline-flex;
    gap: 6px;
    color: #C4B5FD;
    flex-shrink: 0;
  }
</style>
